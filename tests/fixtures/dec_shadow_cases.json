       {
        "path": "decisions/K-BBBB/v2.json",
        "record": {
         "key": "K-BBBB",
         "v": 2,
         "state": "revoked",
         "session": "s1",
         "by": "K-CCCC",
         "text": "K-BBBB v2 revoked"
        }
       }
      ]
     }
    ]
   },
   "expect": {
    "event": {

{
 "schema": "relay-kit/dec-shadow-cases@1",
 "note": "Synthetic. Keys are placeholders, not DEC ids. Steps run on main in order; merge = two branches from the current main.",
 "cases": [
  {
   "name": "supersede_then_revoke",
   "what": "B supersedes A; C revokes B. A must not come back.",
   "event": {
    "steps": [
     {
      "do": "add",
      "files": [
       {
        "path": "decisions/K-AAAA/v1.json",
        "record": {
         "key": "K-AAAA",
         "op": "adopt",
         "session": "s1",
         "text": "adopt K-AAAA"
        }
       }
      ]
     },
     {
      "do": "add",
      "files": [
       {
        "path": "decisions/K-BBBB/v1.json",
        "record": {
         "key": "K-BBBB",
         "op": "supersede",
         "session": "s1",
         "target": "K-AAAA",
         "text": "supersede K-AAAA"
        }
       }
      ]
     },
     {
      "do": "add",
      "files": [
       {
        "path": "decisions/K-CCCC/v1.json",
        "record": {
         "key": "K-CCCC",
         "op": "revoke",
         "session": "s1",
         "target": "K-BBBB",
         "text": "revoke K-BBBB"
        }
       }
      ]
     }
    ]
   },
   "version": {
    "steps": [
     {
      "do": "add",
      "files": [
       {
        "path": "decisions/K-AAAA/v1.json",
        "record": {
         "key": "K-AAAA",
         "v": 1,
         "state": "adopted",
         "session": "s1",
         "text": "K-AAAA v1 adopted"
        }
       }
      ]
     },
     {
      "do": "add",
      "files": [
       {
        "path": "decisions/K-BBBB/v1.json",
        "record": {
         "key": "K-BBBB",
         "v": 1,
         "state": "adopted",
         "session": "s1",
         "text": "K-BBBB v1 adopted"
        }
       },
       {
        "path": "decisions/K-AAAA/v2.json",
        "record": {
         "key": "K-AAAA",
         "v": 2,
         "state": "superseded",
         "session": "s1",
         "by": "K-BBBB",
         "text": "K-AAAA v2 superseded"
        }
       }
      ]
     },
     {
      "do": "add",
